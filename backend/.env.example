# 本地联调配置 (复制为 .env 后按需修改)
# 启动: ./.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

# --- 数据库 ---
# 本地不装 PostgreSQL, 直接用 SQLite
DATABASE_URL=sqlite+aiosqlite:///./zhigu_local.db
# 生产: postgresql+asyncpg://zhigu:zhigu@localhost:5432/zhigu

# --- 时序库 ---
# 留空 = 用进程内内存(重启即清空); 生产填 http://influxdb:8086
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=zhigu
INFLUX_BUCKET=telemetry

# --- Redis (本项目当前未强依赖) ---
REDIS_URL=redis://localhost:6379/0

# --- MQTT ---
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=
MQTT_TLS=true

# --- 本地联调 ---
DEMO_USER_ID=u_8829103
JWT_SECRET=local-dev-secret
